#include <behaviors/unicode.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&uc { default-mode = <UC_MODE_LINUX>; };

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        par: par {
            compatible = "zmk,behavior-mod-morph";
            label = "PAR";
            bindings = <&kp LPAR>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        brc: brc {
            compatible = "zmk,behavior-mod-morph";
            label = "BRC";
            bindings = <&kp LBRC>, <&kp RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bkt: bkt {
            compatible = "zmk,behavior-mod-morph";
            label = "BKT";
            bindings = <&kp LBKT>, <&kp RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc: spc {
            compatible = "zmk,behavior-mod-morph";
            label = "SPC";
            bindings = <&kp SPACE>, <&spc2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LGUI|MOD_RGUI)>;
        };

        del: del {
            compatible = "zmk,behavior-mod-morph";
            label = "DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc2: spc2 {
            compatible = "zmk,behavior-mod-morph";
            label = "SPC2";
            bindings = <&kp TAB>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        rlay0: rlay0 {
            compatible = "zmk,behavior-mod-morph";
            label = "RLAY0";
            bindings = <&to 1>, <&to 2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        eqt: eqt {
            compatible = "zmk,behavior-mod-morph";
            label = "EQT";
            bindings = <&kp EQUAL>, <&eqt2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RCTL|MOD_LGUI|MOD_RGUI)>;
        };

        eqt2: eqt2 {
            compatible = "zmk,behavior-mod-morph";
            label = "EQT2";
            bindings = <&kp LT>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        plmi: plmi {
            compatible = "zmk,behavior-mod-morph";
            label = "PLMI";
            bindings = <&kp PLUS>, <&kp MINUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mltdiv: mltdiv {
            compatible = "zmk,behavior-mod-morph";
            label = "MLTDIV";
            bindings = <&kp ASTERISK>, <&mltdiv2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LGUI|MOD_RGUI)>;
        };

        mltdiv2: mltdiv2 {
            compatible = "zmk,behavior-mod-morph";
            label = "MLTDIV2";
            bindings = <&kp SLASH>, <&kp BACKSLASH>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        undr: undr {
            compatible = "zmk,behavior-mod-morph";
            label = "UNDR";
            bindings = <&kp UNDER>, <&caret>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        entr: entr {
            compatible = "zmk,behavior-mod-morph";
            label = "ENTR";
            bindings = <&kp ENTER>, <&entr2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_LGUI|MOD_RSFT|MOD_RGUI)>;
        };

        entr2: entr2 {
            compatible = "zmk,behavior-mod-morph";
            label = "ENTR2";
            bindings = <&kp END>, <&kp HOME>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        dot: dot {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT";
            bindings = <&kp DOT>, <&dot2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ddot: ddot {
            compatible = "zmk,behavior-mod-morph";
            label = "DDOT";
            bindings = <&kp COLON>, <&ddot2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dot2: dot2 {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT2";
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        ddot2: ddot2 {
            compatible = "zmk,behavior-mod-morph";
            label = "DDOT2";
            bindings = <&kp SEMICOLON>, <&kp PIPE>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        llay0: llay0 {
            compatible = "zmk,behavior-mod-morph";
            label = "LLAY0";
            bindings = <&none>, <&soft_off>;

            #binding-cells = <0>;
            mods = <(MOD_RGUI|MOD_LGUI)>;
        };

        dol: dol {
            compatible = "zmk,behavior-mod-morph";
            label = "DOL";
            bindings = <&kp DOLLAR>, <&kp HASH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        esc: esc {
            compatible = "zmk,behavior-mod-morph";
            label = "ESC";
            bindings = <&kp ESC>, <&bt BT_NXT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };

        f1: f1 {
            compatible = "zmk,behavior-mod-morph";
            label = "F1";
            bindings = <&kp F1>, <&kp F13>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f2: f2 {
            compatible = "zmk,behavior-mod-morph";
            label = "F2";
            bindings = <&kp F2>, <&kp F14>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f3: f3 {
            compatible = "zmk,behavior-mod-morph";
            label = "F3";
            bindings = <&kp F3>, <&kp F15>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f4: f4 {
            compatible = "zmk,behavior-mod-morph";
            label = "F4";
            bindings = <&kp F4>, <&kp F16>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f5: f5 {
            compatible = "zmk,behavior-mod-morph";
            label = "F5";
            bindings = <&kp F5>, <&kp F17>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f6: f6 {
            compatible = "zmk,behavior-mod-morph";
            label = "F6";
            bindings = <&kp F6>, <&kp F18>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f7: f7 {
            compatible = "zmk,behavior-mod-morph";
            label = "F7";
            bindings = <&kp F7>, <&kp F19>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f8: f8 {
            compatible = "zmk,behavior-mod-morph";
            label = "F8";
            bindings = <&kp F8>, <&kp F120>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f9: f9 {
            compatible = "zmk,behavior-mod-morph";
            label = "F9";
            bindings = <&kp F9>, <&kp F21>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f10: f10 {
            compatible = "zmk,behavior-mod-morph";
            label = "F10";
            bindings = <&kp F10>, <&kp F22>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f11: f11 {
            compatible = "zmk,behavior-mod-morph";
            label = "F11";
            bindings = <&kp F11>, <&kp F23>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        f12: f12 {
            compatible = "zmk,behavior-mod-morph";
            label = "F12";
            bindings = <&kp F12>, <&kp F24>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

    };

    macros {
        caret: DACH {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CARET &kp SPACE>;
            label = "DACH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&esc  &kp Q  &kp W  &kp E       &kp R  &kp T       &kp Z   &kp U  &kp I   &kp O  &kp P  &ddot
&dol  &kp A  &kp S  &kp D       &kp F  &kp G       &kp H   &kp J  &kp K   &kp L  &del   &mltdiv
&dot  &kp Y  &kp X  &kp C       &kp V  &kp B       &kp N   &kp M  &par    &undr  &eqt   &plmi
                    &kp LSHIFT  &spc   &kp LGUI    &llay0  &entr  &rlay0
            >;
        };

        NUMBER_LAYER {
            bindings = <
&f1     &f1     &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "NUMR";
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
