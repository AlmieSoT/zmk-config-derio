#include <behaviors/unicode.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&uc { default-mode = <UC_MODE_LINUX>; };

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        par: par {
            compatible = "zmk,behavior-mod-morph";
            label = "PAR";
            bindings = <&kp LPAR>, <&kp RPAR>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        brc: brc {
            compatible = "zmk,behavior-mod-morph";
            label = "BRC";
            bindings = <&kp LBRC>, <&kp RBRC>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        bkt: bkt {
            compatible = "zmk,behavior-mod-morph";
            label = "BKT";
            bindings = <&kp LBKT>, <&kp RBKT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ltgt: ltgt {
            compatible = "zmk,behavior-mod-morph";
            label = "LTGT";
            bindings = <&kp LT>, <&kp GT>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc: spc {
            compatible = "zmk,behavior-mod-morph";
            label = "SPC";
            bindings = <&kp SPACE>, <&spc2>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT|MOD_LGUI|MOD_RGUI)>;
        };

        del: del {
            compatible = "zmk,behavior-mod-morph";
            label = "DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        spc2: spc2 {
            compatible = "zmk,behavior-mod-morph";
            label = "SPC2";
            bindings = <&kp TAB>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI|MOD_RGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESC  &kp Q  &kp W  &kp E       &kp R  &kp T       &kp Z     &kp U      &kp I     &kp O   &kp P          &kp SEMICOLON
&kp TAB  &kp A  &kp S  &kp D       &kp F  &kp G       &kp H     &kp J      &kp K     &kp L   &kp BACKSPACE  &kp SLASH
&kp DOT  &kp Y  &kp X  &kp C       &kp V  &kp B       &kp N     &kp M      &kp LPAR  &kp LT  &kp EQUAL      &kp MINUS
                       &kp LSHIFT  &spc   &kp LGUI    &kp LGUI  &kp ENTER  &mo 0
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
